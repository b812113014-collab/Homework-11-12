public class CH2_P49 {
    public static void main(String[] args) {
        int[][] grades = {{81, 90, 87}, {76, 85, 92}};
        for (int row = 0; row < grades.length; row++) {
            for (int col = 0; col < grades[row].length; col++) {
                System.out.print(grades[row][col] + " ");
            }
            System.out.println();
        }
    }
}
